# Launch xschem from this directory: cd sg13g2/sar_adc/xschem && xschem

# Source the PDK's own xschemrc to pick up its library paths/settings
if {[info exists env(PDK_ROOT)]} {
    source $env(PDK_ROOT)/ihp-sg13g2/libs.tech/xschem/xschemrc
} else {
    puts "Warning: PDK_ROOT not set, PDK symbols may not resolve."
}

# Resolve library path relative to this rcfile's own location,
# so it works regardless of where the repo is cloned on disk.
append XSCHEM_LIBRARY_PATH : [file dirname [info script]]/blocks

# Terminal emulator used by xschem to spawn external processes (simulation, waveform viewer, etc.)
# and to print/display simulation results in a terminal window
# Using gnome-terminal instead of the default xterm for a more convenient/modern terminal experience
set terminal {gnome-terminal -- bash -c}
